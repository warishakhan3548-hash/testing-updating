{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "appData": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "ledgerV2": {
          ".read": false,
          ".write": false,
          "meta": {
            "diary": {
              ".read": "auth != null && auth.uid === $uid"
            }
          },
          "diaryEntries": {
            ".read": "auth != null && auth.uid === $uid",
            ".indexOn": ["_period"]
          },
          "diaryPeriods": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
